# ============================================================
#  분실물 감지 시스템 환경 변수
#  사용법: 이 파일을 .env로 복사 후 값 입력
# ============================================================

# OpenAI API 키 (VLM 백엔드용, GPT-4o 호출)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-...your-key-here...

# 선택: VLM 백엔드 선택 (기본: gpt)
# - gpt   : OpenAI GPT-4o (네트워크·API 키 필요)
# - local : 로컬 모델 (페이즈 8 예정)
# VLM_BACKEND=gpt

# 선택: 로컬 VLM 서버 URL (VLM_BACKEND=local 일 때 사용)
# LOCAL_VLM_URL=http://localhost:8000/predict

# ============================================================
#  영상 소스 설정 (페이즈 7 — RTSP 지원)
# ============================================================

# 영상 소스 선택: file 또는 rtsp
VIDEO_SOURCE=file

# 영상 파일 경로 (VIDEO_SOURCE=file일 때)
VIDEO_FILE_PATH=case1.mp4

# RTSP URL (VIDEO_SOURCE=rtsp일 때)
# 형식: rtsp://USER:PASSWORD@CAMERA_IP:554/stream1
# Tapo C210: 앱 → 카메라 → 설정 → 고급 설정 → 카메라 계정 활성화 필요
# RTSP_URL=rtsp://username:password@192.168.0.100:554/stream1

# RTSP 재시도 정책 (선택)
# RTSP_RETRY_COUNT=3
# RTSP_RETRY_WAIT=5
